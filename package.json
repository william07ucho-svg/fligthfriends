{
  "name": "flight-friends",
  "version": "1.0.1",
  "description": "Compartilhamento de voos do Microsoft Flight Simulator",
  "main": "main.js",
  "author": "Flight Friends",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis portable"
  },
  "dependencies": {
  "peerjs": "^1.5.4",
  "electron-updater": "^6.6.2"
},
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.flightfriends.desktop",
    "productName": "Flight Friends",
    "directories": {
  "output": "dist"
},
"publish": [
  {
    "provider": "github",
    "owner": "william07ucho-svg",
    "repo": "fligthfriends"
  }
],
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "node_modules/peerjs/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "FlightFriends-Portable.exe"
    }
  },
  "allowScripts": {
    "electron@34.5.8": true,
    "electron-winstaller@5.4.0": true
  }
}
